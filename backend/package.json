{
  "name": "exaforge-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "migrate:up": "dotenv -e .env tsx node_modules/node-pg-migrate/bin/node-pg-migrate up",
    "migrate:down": "dotenv -e .env tsx node_modules/node-pg-migrate/bin/node-pg-migrate down",
    "test": "tsx --test test/core.test.ts test/auth.test.ts test/uploads.test.ts test/idempotency.test.ts",
    "test:integration": "tsx --test test/integration.test.ts",
    "worker:email": "tsx src/workers/emailWorker.ts",
    "worker:notification": "tsx src/workers/notificationWorker.ts",
    "workers": "concurrently \"npm run worker:email\" \"npm run worker:notification\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^0.10.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.9.1",
    "multer": "^2.2.0",
    "pg": "^8.16.3",
    "redis": "^4.7.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/amqplib": "^0.10.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^7.4.3",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "node-pg-migrate": "^7.8.2",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
